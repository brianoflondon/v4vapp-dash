DASH_NETWORK=regtest
DASH_API_KEY=change-me-long-random
DASH_API_KEY_PREV=
DASH_BIND=0.0.0.0
DASH_PORT=8080
DASH_DOCS_ENABLED=true

# rsPytest / mongo-pytest-local: NO auth (backend DBConn strips credentials for rsPytest).
# Host process on dot (devhive.config.yaml hosts: [dot:37017]):
MONGO_URI=mongodb://dot:37017/v4vapp-dev?replicaSet=rsPytest
# From another Docker stack (devdocker.config.yaml):
# MONGO_URI=mongodb://dot.tail400e5.ts.net:37017/v4vapp-dev?replicaSet=rsPytest
# Replica set member is advertised as the Tailscale IP of dot (100.89.33.19:37017).
MONGO_DB_NAME=v4vapp-dev
# Production rsV (auth, scoped user) — do not commit a real password:
# MONGO_URI=mongodb://v4vapp-dash-user:SECRET@gad-v4vapp.tail400e5.ts.net:27017,edi-v4vapp.tail400e5.ts.net:27017,dave-v4vapp.tail400e5.ts.net:27017/v4vapp-backend?authSource=v4vapp-backend&replicaSet=rsV

# Yoga Tailscale node (mainnet, after IBD). Password lives in deploy/dashd/.env — do not commit it.
# DASH_RPC_URL=http://100.83.149.118:9998
# DASH_RPC_USER=v4vapp-dashrpc
# DASH_RPC_PASSWORD=
# Local/regtest compose:
DASH_RPC_URL=http://dashd:9998
DASH_RPC_WALLET=watch
DASH_RPC_USER=dashrpc
DASH_RPC_PASSWORD=change-me

# Prefer the JSON secret file from `python -m v4vapp_dash.wallet.derive_xpub`
DASH_XPUB_FILE=/run/secrets/dash_xpub
# DASH_XPUB=
# DASH_MASTER_FINGERPRINT=
# DASH_MNEMONIC_FILE=

DASH_POLL_INTERVAL_S=10
DASH_SETTLE_POLICY=conf_n
DASH_MIN_CONF=1
DASH_SETTLE_GRACE_S=3600
DASH_UNDERPAY_BPS=100
DASH_UNDERPAY_DUFFS=50000
DASH_DESCRIPTOR_RANGE_END=100000
DASH_WATCH_BATCH=500
DASH_DUST_DUFFS=5460
DASH_PAYOUTS_ENABLED=false

COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price
COINMARKETCAP_API_KEY=
WATCH_FALLBACK_URL=
